# Optional. Variables are read from your operating system environment.
# Do NOT commit actual API keys or secrets.
PANTA_API_KEY=REPLACE_WITH_NEW_ROTATED_KEY
PANTA_API_BASE=https://live-api.panta.market/api/v1
# Server binds to localhost by default. Use 0.0.0.0 only behind a trusted proxy.
OUTCOMEOS_HOST=127.0.0.1
PORT=8766
# Enable this only if the application is accessed over HTTPS.
OUTCOMEOS_COOKIE_SECURE=0
# OUTCOMEOS_DB=./data/outcomeos.sqlite3

# For Neon PostgreSQL: set DATABASE_URL (never commit its password).
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# OUTCOMEOS_REQUIRE_POSTGRES=1 (required on Render)
# OUTCOMEOS_SEED_EXAMPLES=0 (no synthetic onboarding data)
